    "Assign shortcuts for Finder’s “Sort with Binky” in System Settings → Keyboard → Keyboard Shortcuts → Services.": {
      "comment": "Settings Shortcuts tab footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weisen Sie Verknüpfungen für „Mit Binky komprimieren“ im Finder in den Systemeinstellungen → Tastatur → Tastaturkürzel → Dienste zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigne atajos para “Comprimir con Binky” de Finder en Configuración del sistema → Teclado → Atajos de teclado → Servicios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez des raccourcis pour « Compresser avec Binky » du Finder dans Paramètres système → Clavier → Raccourcis clavier → Services."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna scorciatoie per \"Comprimi con Binky\" del Finder in Impostazioni di sistema → Tastiera → Scorciatoie da tastiera → Servizi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → キーボード → キーボード ショートカット → サービスで、Finder の「Binky で圧縮」のショートカットを割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 키보드 → 키보드 단축키 → 서비스에서 Finder의 \"Binky로 압축\"에 대한 단축키를 지정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs snelkoppelingen toe voor Finder's \"Comprimeren met Binky\" in Systeeminstellingen → Toetsenbord → Sneltoetsen → Services."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribua atalhos para “Compactar com Binky” do Finder em Configurações do sistema → Teclado → Atalhos de teclado → Serviços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте сочетания клавиш для «Сжатия с помощью Binky» в Finder в «Системные настройки» → «Клавиатура» → «Сочетания клавиш» → «Службы»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Klavye → Klavye Kısayolları → Hizmetler bölümünde Finder'ın “Binky ile Sıkıştır” özelliği için kısayollar atayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 键盘 → 键盘快捷键 → 服务中为访达的“Sort with Binky”分配快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 → 鍵盤 → 鍵盤快速鍵 → 服務中為 Finder 的「使用 Binky 壓縮」指派快速鍵。"
          }
        }
      }
    },
