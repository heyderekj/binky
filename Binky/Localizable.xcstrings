    "Paths you pass aren’t sandboxed; bookmarks from the Finder sheet don’t propagate to Terminal.": {
      "comment": "CLI security footnote in Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angegebene Pfade sind nicht in der Sandbox; Bookmarks aus dem Finder-Dialog gelten nicht im Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rutas que indiques no están en un entorno aislado; los marcadores del panel del Finder no se propagan a Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chemins que tu fournis ne sont pas isolés (sandbox) ; les signets de la feuille Finder ne se propagent pas à Terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I percorsi che passi non sono in sandbox; i segnalibri dal pannello del Finder non si propagano a Terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡したパスはサンドボックス化されません。Finder シートのブックマークはターミナルには引き継がれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달한 경로는 샌드박스에 들어가지 않아요. Finder 시트의 북마크는 터미널로 전달되지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paden die je doorgeeft zitten niet in een sandbox; bladwijzers uit het Finder-venster worden niet doorgegeven aan Terminal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os caminhos que você passa não ficam em sandbox; os favoritos da janela do Finder não se propagam para o Terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указанные вами пути не изолированы в песочнице; закладки из окна Finder не передаются в Терминал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiğin yollar sanal alanda değildir; Finder sayfasındaki yer imleri Terminal’e geçmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您传入的路径不受沙盒限制；访达工作表中的书签不会传播到终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您傳入的路徑不受沙盒限制；Finder 工作表中的書籤不會傳播到終端。"
          }
        }
      }
    },
