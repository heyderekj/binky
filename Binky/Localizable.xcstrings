    "Runs before automatic destinations. Add extensions, sites, or size rules only if you need them.": {
      "comment": "Rule editor When footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft vor den automatischen Zielen. Füge Endungen, Websites oder Größenregeln nur hinzu, wenn du sie brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica antes que los destinos automáticos. Añade extensiones, sitios o reglas de tamaño solo si los necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique avant les destinations automatiques. N’ajoute des extensions, des sites ou des règles de taille que si tu en as besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si attivano prima delle destinazioni automatiche. Aggiungi estensioni, siti o limiti di dimensione solo se ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動の行き先より先に実行されます。拡張子、サイト、サイズの条件は、必要なときだけ追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 대상보다 먼저 실행돼요. 확장자, 사이트, 크기 규칙은 필요할 때만 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait vóór automatische bestemmingen. Voeg alleen extensies, sites of groottebeperkingen toe als je die nodig hebt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda antes dos destinos automáticos. Adicione extensões, sites ou regras de tamanho só se precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется перед автоматическими назначениями. Добавляйте расширения, сайты или размеры, только если они нужны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik hedeflerden önce çalışır. Uzantı, site ya da boyut kurallarını yalnızca gerekirse ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在自动目标之前运行。仅在需要时添加扩展名、网站或大小规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在自動目標之前執行。僅在需要時加入副檔名、網站或大小規則。"
          }
        }
      }
    },
    "Runs show up here after your first sweep.": {
      "comment": "Quick Sort empty hint.",
      "localizations": {
