        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cartelle osservate, routine e risoluzione completa dei problemi, apri Aiuto di Binky dal menu Aiuto (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視フォルダ、ルーティン、詳しいトラブルシューティングは、ヘルプメニュー(%@)から Binky ヘルプを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감시 폴더, 루틴, 자세한 문제 해결은 도움말 메뉴(%@)에서 Binky 도움말을 열어 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor bewaakte mappen, routines en uitgebreide probleemoplossing open je Binky-hulp via het menu Help (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pastas monitoradas, rotinas e solução completa de problemas, abra a Ajuda do Binky no menu Ajuda (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Про отслеживаемые папки, сценарии и устранение неполадок читайте в справке Binky из меню «Справка» (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenen klasörler, rutinler ve tüm sorun giderme için Yardım menüsünden Binky Yardım’ı aç (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于监视文件夹、例程和完整故障排除，请从帮助菜单（%@）打开 Binky 帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
