    "Replaces only the type-based tags. Routine tags and “Tags on match” still apply after.": {
      "comment": "Rule editor: replace tags hint.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt nur die typbasierten Tags. Routine-Tags und „Tags bei Treffer“ gelten danach weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye solo las etiquetas basadas en el tipo. Las etiquetas de rutina y «Etiquetas al coincidir» se siguen aplicando después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne remplace que les tags basés sur le type. Les tags de routine et « Tags si correspondance » s’appliquent toujours ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce solo i tag basati sul tipo. I tag della routine e “Tag alla corrispondenza” si applicano comunque dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類別のタグだけを置き換えます。ルーティンのタグと「一致時のタグ」は、そのあとも適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종류별 태그만 대체해요. 루틴 태그와 “일치 시 태그”는 그 뒤에도 적용돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangt alleen de typegebaseerde tags. Routinetags en “Tags bij match” gelden daarna nog steeds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui só as tags baseadas no tipo. As tags da rotina e “Tags ao corresponder” ainda se aplicam depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет только метки по типу. Метки сценария и «Метки при совпадении» применяются после."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca türe dayalı etiketleri değiştirir. Rutin etiketleri ve “Eşleşmede etiketler” sonrasında yine uygulanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅替换基于类型的标签。之后常规标签和“比赛标签”仍然适用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
