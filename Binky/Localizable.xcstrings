    "Checks last opened, last used, and date added. Runs about once a day while Binky is open.": {
      "comment": "Aging footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft zuletzt geöffnet, zuletzt verwendet und Hinzugefügt-Datum. Läuft etwa einmal am Tag, solange Binky geöffnet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba última apertura, último uso y fecha de incorporación. Se ejecuta una vez al día aproximadamente mientras Binky esté abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la dernière ouverture, la dernière utilisation et la date d’ajout. S’exécute environ une fois par jour tant que Binky est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla ultima apertura, ultimo uso e data di aggiunta. Va circa una volta al giorno mentre Binky è aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に開いた日、最後に使った日、追加日を調べます。Binky を開いている間、1 日に 1 回ほど実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 연 날짜, 마지막 사용 날짜, 추가한 날짜를 확인해요. Binky가 열려 있는 동안 하루에 한 번쯤 실행돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleert laatst geopend, laatst gebruikt en datum van toevoegen. Draait ongeveer één keer per dag zolang Binky open is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica última abertura, último uso e data de adição. Roda cerca de uma vez por dia enquanto o Binky está aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитываются время последнего открытия, последнего использования и добавления. Выполняется примерно раз в день, пока Binky запущен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son açılma, son kullanım ve eklenme tarihine bakar. Binky açıkken günde yaklaşık bir kez çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查最后打开、最后使用和添加日期。Binky 运行时大约每天执行一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查上次開啟、上次使用和新增日期。 Binky 開放期間每天運行一次。"
          }
        }
      }
    },
