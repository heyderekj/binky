    ".%@ files keep going to %@.": {
      "comment": "Review triage habit banner; file extension, then folder path.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien vom Typ .%@ landen weiterhin in %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ".%1$@ files keep going to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos .%@ siguen yendo a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers .%@ continuent d’aller dans %@."
