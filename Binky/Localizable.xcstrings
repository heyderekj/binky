    "No aging rules yet. Add one per category you want swept.": {
      "comment": "Aging rules empty state.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Alterungsregeln. Füge eine pro Kategorie hinzu, die aufgeräumt werden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay reglas de antigüedad. Añade una por cada categoría que quieras barrer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune règle d’ancienneté pour l’instant. Ajoute-en une par catégorie à balayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna regola di archiviazione. Aggiungine una per ogni categoria da ripulire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージング規則はまだありません。掃除したいカテゴリごとに追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관 규칙이 아직 없어요. 정리하고 싶은 카테고리마다 하나씩 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen archiefregels. Voeg er één toe per categorie die je wilt opruimen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma regra de arquivamento ainda. Adicione uma por categoria que quiser varrer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил давности пока нет. Добавьте по одному для каждой категории, которую нужно разгрести."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eskime kuralı yok. Süpürülmesini istediğin her kategori için bir tane ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有老化规则。为你想清理的每个类别添加一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
