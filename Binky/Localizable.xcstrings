    "Simple is unavailable while routines are configured. Expanded keeps them visible.": {
      "comment": "Settings UI: simple sidebar unavailable when routines exist.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Einfach“ ist nicht verfügbar, solange Routinen eingerichtet sind. „Erweitert“ hält sie sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sencillo» no está disponible mientras haya rutinas configuradas. «Ampliado» las mantiene visibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Simple » n’est pas disponible tant que des routines sont configurées. « Étendu » les garde visibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Semplice non è disponibile se ci sono routine configurate. Esteso le mantiene visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンを設定している間は「シンプル」を使えません。「詳細」ならルーティンも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴이 설정돼 있으면 간단히를 쓸 수 없어요. 자세히는 루틴을 계속 보여 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenvoudig is niet beschikbaar zolang routines zijn ingesteld. Uitgebreid houdt ze zichtbaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simples não está disponível enquanto houver rotinas configuradas. Expandido as mantém visíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Просто» недоступно, пока настроены сценарии. «Подробно» оставляет их на виду."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutinler ayarlıyken Basit kullanılamaz. Ayrıntılı onları görünür tutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置例程时，简洁模式不可用。展开模式保持可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定常式時，簡潔模式不可用。展開模式保持可見。"
          }
        }
      }
    },
