    "Overrides global defaults for files sorted under this automation. Leave blank to inherit.": {
      "comment": "Per-type tag hint.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt die globalen Standards für Dateien, die unter dieser Automatisierung sortiert werden. Leer lassen, um sie zu übernehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye los valores globales para los archivos ordenados con esta automatización. Déjalo en blanco para heredarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace les valeurs globales pour les fichiers triés par cette automatisation. Laisse vide pour hériter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce i valori predefiniti globali per i file smistati da questa automazione. Lascia vuoto per ereditarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この自動処理で整理したファイルについて、グローバルのデフォルトを上書きします。空欄なら引き継ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화로 정리하는 파일에 대해 전역 기본값을 덮어써요. 비워 두면 그대로 따라가요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschrijft de globale standaarden voor bestanden die via deze automatisering worden gesorteerd. Laat leeg om over te nemen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui os padrões globais para arquivos organizados por esta automação. Deixe em branco para herdar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переопределяет общие настройки для файлов, отсортированных этим сценарием. Оставьте пустым, чтобы наследовать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu otomasyonla sıralanan dosyalar için genel varsayılanları geçersiz kılar. Devralmak için boş bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖此自动化下整理文件的全局默认值。留空则继承。"
