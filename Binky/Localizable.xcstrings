      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständige Absturzdetails sind in deiner Zwischenablage — füge sie hier ein.\n\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles completos del cierre inesperado están en tu portapapeles: pégalos aquí.\n\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails complets du plantage sont dans ton presse-papiers — colle-les ici.\n\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dettagli completi del crash sono stati copiati negli appunti: incollali qui.\n\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュの詳細をすべてクリップボードにコピーしました。ここに貼り付けてください。\n\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 비정상 종료 세부 정보를 클립보드에 복사했어요. 여기에 붙여넣으세요.\n\n"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volledige crashdetails zijn naar je klembord gekopieerd — plak ze hier.\n\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes completos da falha foram copiados para a área de transferência — cole aqui.\n\n"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полные данные о сбое скопированы в буфер обмена — вставьте их сюда.\n\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çökmenin tüm ayrıntıları panoya kopyalandı — buraya yapıştır.\n\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的崩溃详细信息已复制到剪贴板 - 粘贴到此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的崩潰詳細資訊已複製到剪貼簿 - 貼上到此處。"
          }
        }
      }
    },
