    "To receive notifications during Focus or Do Not Disturb, allow Binky in System Settings → Focus.": {
      "comment": "Settings UI.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Mitteilungen auch bei Fokus oder „Nicht stören“ zu erhalten, erlaube Binky in Systemeinstellungen → Fokus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir notificaciones durante un modo de concentración o No molestar, permite Binky en Ajustes del Sistema → Concentración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des notifications pendant un Concentration ou Ne pas déranger, autorise Binky dans Réglages Système → Concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere notifiche durante Full immersion o Non disturbare, consenti Binky in Impostazioni di Sistema → Full immersion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードやおやすみモード中も通知を受け取るには、システム設定 → 集中モードで Binky を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 모드나 방해 금지 중에도 알림을 받으려면 시스템 설정 → 집중 모드에서 Binky를 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om meldingen te ontvangen tijdens Focus of Niet storen, geef je Binky toestemming in Systeeminstellingen → Focus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber notificações durante o Foco ou Não Perturbe, permita o Binky em Ajustes do Sistema → Foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы получать уведомления в режиме «Фокусировка» или «Не беспокоить», разрешите Binky в Системных настройках → Фокусирование."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak veya Rahatsız Etme sırasında bildirim almak için Binky’ye Sistem Ayarları → Odak bölümünde izin ver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在“专注模式”或“请勿打扰”期间接收通知，请在“系统设置”→“专注模式”中允许 Binky。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要在「專注模式」或「勿擾模式」期間接收通知，請在「系統設定」→「專注模式」中允許 Binky。"
          }
        }
      }
    },
    "Today: %1$lld sorted · %2$lld review · %3$lld dupes skipped · %4$lld receipts · %5$lld archived. Quietly handled.": {
      "comment": "Daily digest; five counts.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute: %1$lld sortiert · %2$lld in Prüfung · %3$lld Duplikate übersprungen · %4$lld Belege · %5$lld archiviert. Ruhig erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy: %1$lld ordenados · %2$lld en revisión · %3$lld duplicados omitidos · %4$lld recibos · %5$lld archivados. Todo resuelto con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui : %1$lld triés · %2$lld à vérifier · %3$lld doublons ignorés · %4$lld reçus · %5$lld archivés. Réglé en douceur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi: %1$lld smistati · %2$lld da rivedere · %3$lld duplicati saltati · %4$lld ricevute · %5$lld archiviati. Tutto sotto controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日: 整理 %1$lld · 確認 %2$lld · 重複スキップ %3$lld · 領収書 %4$lld · アーカイブ %5$lld。静かに片付きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘: 정리 %1$lld · 검토 %2$lld · 중복 건너뜀 %3$lld · 영수증 %4$lld · 보관 %5$lld. 조용히 처리됐어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag: %1$lld gesorteerd · %2$lld te controleren · %3$lld duplicaten overgeslagen · %4$lld bonnetjes · %5$lld gearchiveerd. Rustig afgehandeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje: %1$lld organizados · %2$lld em revisão · %3$lld duplicados ignorados · %4$lld recibos · %5$lld arquivados. Tudo resolvido com calma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня: отсортировано %1$lld · на проверке %2$lld · пропущено дубликатов %3$lld · чеков %4$lld · в архив %5$lld. Тихо обработано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün: %1$lld sıralandı · %2$lld incelemede · %3$lld kopya atlandı · %4$lld makbuz · %5$lld arşivlendi. Sessizce halledildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日：%1$lld 已整理 · %2$lld 待审 · %3$lld 重复跳过 · %4$lld 收据 · %5$lld 已归档。安静处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
