    "Binky couldn’t reach GitHub. Probably the internet. Try again in a sec?": {
      "comment": "Manual update: network error detail.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky konnte GitHub nicht erreichen. Wahrscheinlich das Internet. Gleich nochmal versuchen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky no pudo conectar con GitHub. Seguramente sea internet. ¿Lo intentas de nuevo en un momento?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky n’a pas pu joindre GitHub. Sans doute Internet. Réessayer dans un instant ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky non è riuscito a raggiungere GitHub. Probabilmente internet. Riprovi tra un attimo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky は GitHub に接続できませんでした。たぶんインターネットです。もう一度試しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky가 GitHub에 연결하지 못했어요. 아마 인터넷 문제일 거예요. 잠시 뒤 다시 해 볼까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky kon GitHub niet bereiken. Waarschijnlijk het internet. Zo nog eens proberen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Binky não conseguiu falar com o GitHub. Provavelmente a internet. Tenta de novo em instantes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky не достучался до GitHub. Скорее всего, дело в интернете. Попробовать ещё раз?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky GitHub’a ulaşamadı. Muhtemelen internet. Birazdan tekrar dene?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky 无法访问 GitHub。可能是网络问题。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky 無法存取 GitHub。可能是互聯網。請稍後重試？"
          }
        }
      }
    },
