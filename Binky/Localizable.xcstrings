    "Leave blank to use Binky’s built-in hint for each type. Routine settings can override these per workflow.": {
      "comment": "Settings: Finder tag defaults footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um Binkys integrierten Hinweis für jeden Typ zu verwenden. Routine-Einstellungen können diese pro Ablauf überschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para usar la pista integrada de Binky para cada tipo. Los ajustes de una rutina pueden sustituirlas según el flujo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse vide pour utiliser l’indice intégré de Binky pour chaque type. Les réglages d’une routine peuvent les remplacer pour chaque flux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare l’indicazione predefinita di Binky per ogni tipo. Le impostazioni della routine possono sostituirle per ogni flusso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にすると、Binky 内蔵のヒントを種類ごとに使います。ルーティンの設定でワークフロー別に上書きできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 Binky 기본 힌트를 종류별로 써요. 루틴 설정에서 워크플로별로 덮어쓸 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om Binky’s ingebouwde hint per type te gebruiken. Routine-instellingen kunnen deze per workflow overschrijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar a dica padrão do Binky para cada tipo. As configurações da rotina podem substituí-las por fluxo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать встроенные подсказки Binky для каждого типа. В настройках сценария их можно переопределить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tür için Binky’nin yerleşik ipucunu kullanmak üzere boş bırak. Rutin ayarları bunları iş akışı başına geçersiz kılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
