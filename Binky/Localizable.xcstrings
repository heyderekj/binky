    "Separate tags with commas. Leave empty for the built-in tag.": {
      "comment": "VoiceOver hint for per-category Finder tag field.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags durch Kommas trennen. Leer lassen für den integrierten Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa las etiquetas con comas. Déjalo en blanco para la etiqueta integrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sépare les tags par des virgules. Laisse vide pour le tag intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa i tag con virgole. Lascia vuoto per il tag predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグはカンマで区切ります。空欄なら内蔵タグを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그는 쉼표로 구분하세요. 비우면 기본 제공 태그를 써요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheid tags met komma’s. Laat leeg voor de ingebouwde tag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe as tags com vírgulas. Deixe vazio para usar a tag padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделяйте метки запятыми. Оставьте пустым, чтобы использовать встроенную метку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketleri virgülle ayır. Yerleşik etiket için boş bırak."
          }
        },
        "zh-Hans": {
