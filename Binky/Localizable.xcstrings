    "Opens Binky's Review folder so you can place what it couldn't.": {
      "comment": "Shortcuts: Tidy Review intent description.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Binkys Prüfordner, damit du ablegen kannst, was es nicht zuordnen konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la carpeta de revisión de Binky para que coloques lo que no supo ubicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le dossier à vérifier de Binky pour que tu places ce qu’il n’a pas su classer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la cartella Da rivedere di Binky così puoi sistemare ciò che non ha saputo collocare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky の「確認」フォルダを開いて、振り分けられなかったものを置き場所へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky가 분류하지 못한 파일을 둘 수 있게 검토 폴더를 열어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Binky’s Controle-map zodat je kunt plaatsen wat hij niet kon plaatsen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a pasta Revisão do Binky para você colocar no lugar o que ele não soube onde pôr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает папку «На проверку» Binky, чтобы вы разложили то, что он не смог."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky’nin İnceleme klasörünü açar; yerleştiremediklerini sen yerleştirirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Binky 的“待确认”文件夹，你来安置它没法分拣的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Binky 的待審檔案夾，讓你處理它沒能歸位的檔案。"
          }
        }
      }
    },
    "Opens the move/review summary when autonomous sorting batches finish.": {
      "comment": "Settings UI.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Zusammenfassung Verschieben/Prüfung, wenn automatische Sortierstapel fertig sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el resumen de movimientos/revisión cuando terminan los lotes de ordenación automática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le résumé déplacements/vérification quand les lots de tri automatiques sont terminés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il riepilogo spostamenti / da rivedere al termine dei lotti di smistamento automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動の整理バッチが終わったら、移動 / 確認サマリーを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 정리 배치가 끝나면 이동 / 검토 요약을 열어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de samenvatting van verplaatst / te controleren zodra automatische sorteerbatches klaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o resumo de movidos / em revisão quando os lotes de organização automática terminam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает сводку о перемещённом и файлах на проверке, когда завершается автоматическая сортировка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik sıralama partileri bitince taşıma/inceleme özetini açar."
          }
        },
        "zh-Hans": {
