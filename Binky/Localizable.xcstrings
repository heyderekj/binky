    "Rules that “Install app from disk image” copy .app bundles here. Leave default for ~/Applications.": {
      "comment": "DMG install hint.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln mit „App aus Disk-Image installieren“ kopieren .app-Pakete hierhin. Standard ist ~/Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas «Instalar app desde imagen de disco» copian aquí los paquetes .app. Deja el valor predeterminado para ~/Applications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles « Installer l’app depuis une image disque » copient les bundles .app ici. Laisse la valeur par défaut pour ~/Applications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole “Installa app da immagine disco” copiano qui i pacchetti .app. Lascia il valore predefinito per ~/Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ディスクイメージからアプリをインストール」ルールは、.app バンドルをここにコピーします。デフォルトは ~/Applications です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“디스크 이미지에서 앱 설치” 규칙은 .app 번들을 여기로 복사해요. 기본값은 ~/Applications예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regels die “App installeren vanuit schijfkopie” gebruiken, kopiëren .app-bundels hierheen. Laat op standaard voor ~/Programma’s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras “Instalar app a partir de imagem de disco” copiam pacotes .app para cá. Deixe o padrão para ~/Aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила «Установить приложение из образа диска» копируют пакеты .app сюда. Оставьте по умолчанию для ~/Applications."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Disk görüntüsünden uygulama yükle” kuralları .app paketlerini buraya kopyalar. ~/Applications için varsayılanı bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“从磁盘映像安装应用程序”的规则将 .app 捆绑包复制到此处。保留默认值 ~/Applications。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「從磁碟映像安裝應用程式」的規則將 .app 捆綁包複製到此處。保留預設值 ~/Applications。"
          }
        }
      }
    },
