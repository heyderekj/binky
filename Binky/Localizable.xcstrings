    "Files acting up? Pop in a Binky.": {
      "comment": "Organizer empty state: rotating playful tagline.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien zicken? Gib ihnen einen Binky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Archivos revoltosos? Dales un Binky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fichiers capricieux ? Un Binky les calmera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File che fanno i capricci? Chiama Binky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが騒がしい? Binky をどうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 말썽인가요? Binky를 물려 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden die het lastig maken? Pak er een Binky bij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos dando trabalho? Chame o Binky."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы капризничают? Позовите Binky."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar yaramazlık mı yapıyor? Bir Binky ver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件不听话？塞个 Binky。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案不聽話？塞個 Binky。"
          }
        }
      }
    },
    "Files from %@ keep going to %@.": {
      "comment": "Review triage habit banner; site, then folder path.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien von %@ landen weiterhin in %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Files from %1$@ keep going to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de %@ siguen yendo a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de %@ continuent d’aller dans %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file da %@ continuano ad andare in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のファイルは今後も %@ に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 파일은 계속 %@(으)로 보내요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden van %@ gaan nog steeds naar %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de %@ continuam indo para %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы с %@ по-прежнему отправляются в %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kaynaklı dosyalar hâlâ %@ konumuna gidiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@ 的文件会继续放进 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 %@ 的檔案一直都放到 %@。"
          }
        }
      }
    },
    "Files in Review didn’t match a rule. Move them, teach Binky a new rule, or trash.": {
      "comment": "Review triage subtitle.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien in der Prüfung passten zu keiner Regel. Verschiebe sie, bring Binky eine neue Regel bei oder wirf sie weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos en revisión no coincidieron con ninguna regla. Muévelos, enséñale a Binky una regla nueva o mándalos a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers à vérifier ne correspondaient à aucune règle. Déplace-les, apprends une nouvelle règle à Binky ou mets-les à la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file in Da rivedere non corrispondevano a nessuna regola. Spostali, insegna a Binky una nuova regola o buttali nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「確認」のファイルはどのルールにも一致しませんでした。移動する、Binky に新しいルールを教える、またはゴミ箱へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 폴더의 파일은 어떤 규칙에도 맞지 않았어요. 직접 옮기거나, Binky에게 새 규칙을 알려 주거나, 휴지통으로 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden in Controle kwamen met geen enkele regel overeen. Verplaats ze, leer Binky een nieuwe regel of gooi ze weg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos em Revisão não corresponderam a nenhuma regra. Mova-os, ensine uma regra nova ao Binky ou envie para a Lixeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы в «На проверку» не подошли ни под одно правило. Переместите их, научите Binky новому правилу или отправьте в Корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelemedeki dosyalar hiçbir kurala uymadı. Taşı, Binky’ye yeni bir kural öğret ya da Çöp Sepeti’ne at."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待审文件夹中的文件未匹配任何规则。可以移动它们、教 Binky 新规则，或直接丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待審檔案夾中的檔案未符合任何規則。可以移動它們、教 Binky 新規則，或直接丟棄。"
          }
        }
      }
    },
    "Files mid-download wait until they settle.": {
      "comment": "Organizer empty state: incomplete download hint.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die noch geladen werden, warten, bis sie fertig sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que aún se están descargando esperan a asentarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers en cours de téléchargement attendent d’être stables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file in corso di download aspettano che si assestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード途中のファイルは、落ち着くまで待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 중인 파일은 안정될 때까지 기다려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden die nog downloaden wachten tot ze klaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos ainda sendo baixados esperam até se estabilizarem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, которые ещё скачиваются, ждут, пока всё закончится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilmekte olan dosyalar oturana kadar bekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载的文件会等待完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件正在下載，請等待它們穩定下來。"
          }
        }
      }
    },
    "Files to sort into your watch folder sorted folders.": {
      "comment": "Description of the files parameter in the Sort Files with Binky intent.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die in die sortierten Ordner deines Überwachungsordners sortiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos que se ordenarán en las carpetas ordenadas de tu carpeta vigilada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers à trier dans les dossiers triés de ton dossier surveillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File da smistare nelle cartelle ordinate della tua cartella osservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視フォルダの整理先フォルダに整理するファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감시 폴더의 정리 폴더로 정리할 파일."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden om te sorteren in de gesorteerde mappen van je bewaakte map."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos para organizar nas pastas organizadas da sua pasta monitorada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы для сортировки по папкам вашей отслеживаемой папки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
