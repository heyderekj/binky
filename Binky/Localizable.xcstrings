    "Keeps watch-folder sorting awake even when the window is closed. Use the menu bar for Sort Now and History.": {
      "comment": "Settings UI: menu bar mode hint.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Sortierung der Überwachungsordner wach, auch wenn das Fenster geschlossen ist. Nutze die Menüleiste für „Jetzt sortieren“ und den Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene activa la ordenación de las carpetas vigiladas aunque la ventana esté cerrada. Usa la barra de menús para Ordenar ahora y el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le tri des dossiers surveillés actif même fenêtre fermée. Utilise la barre des menus pour Trier maintenant et l’historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene attivo lo smistamento delle cartelle osservate anche a finestra chiusa. Usa la barra dei menu per Smista ora e Cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じても、監視フォルダの整理を動かし続けます。今すぐ整理と履歴はメニューバーから使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 닫아도 감시 폴더 정리를 계속해요. 지금 정리와 기록은 메뉴 막대에서 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt het sorteren van bewaakte mappen actief, ook als het venster gesloten is. Gebruik de menubalk voor Nu sorteren en Geschiedenis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a organização das pastas monitoradas ativa mesmo com a janela fechada. Use a barra de menus para Organizar agora e Histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортировка отслеживаемых папок продолжается и при закрытом окне. «Сортировать сейчас» и «Историю» ищите в строке меню."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenen klasör sıralaması pencere kapalıyken de sürer. Şimdi Sırala ve Geçmiş için menü çubuğunu kullan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使窗口关闭，监视文件夹整理仍保持运行。使用菜单栏进行立即整理和查看历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使視窗關閉，監視資料夾排序也保持喚醒狀態。使用功能表列進行「立即排序」和「歷史記錄」。"
          }
        }
      }
    },
