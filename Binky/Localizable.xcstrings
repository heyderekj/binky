    "This clears Binky’s memory of files it’s seen. Duplicates won’t be recognized until they’re sorted again.": {
      "comment": "Clear hash store explanation.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit vergisst Binky, welche Dateien es schon gesehen hat. Duplikate werden erst erkannt, wenn sie erneut sortiert wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra la memoria de Binky sobre los archivos que ha visto. Los duplicados no se reconocerán hasta que se vuelvan a ordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface la mémoire de Binky sur les fichiers déjà vus. Les doublons ne seront reconnus qu’après un nouveau tri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cancella la memoria di Binky dei file visti. I duplicati non verranno riconosciuti finché non saranno smistati di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky が見たファイルの記憶を消去します。再び整理されるまで、重複は認識されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky가 본 파일에 대한 기억을 지워요. 다시 정리되기 전까지 중복을 알아보지 못해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wist Binky’s geheugen van bestanden die hij heeft gezien. Duplicaten worden pas herkend als ze opnieuw zijn gesorteerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto apaga a memória do Binky sobre os arquivos que ele já viu. Duplicados só serão reconhecidos depois de organizados de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сотрёт память Binky о виденных файлах. Дубликаты не будут распознаваться, пока файлы не отсортируются снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Binky’nin gördüğü dosyalara dair hafızasını siler. Kopyalar, yeniden sıralanana kadar tanınmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会清除 Binky 记住的文件记录。重复项需再次整理后才会被识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會清除 Binky 記住的檔案紀錄。重複項需再次整理後才會被識別。"
          }
        }
      }
    },
