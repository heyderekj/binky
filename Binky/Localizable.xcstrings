    "Quiet folders. Nothing to report.": {
      "comment": "Daily digest empty.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhige Ordner. Nichts zu melden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas tranquilas. Nada que contar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossiers tranquilles. Rien à signaler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle tranquille. Niente da riferire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダは静かです。報告することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더가 조용해요. 보고할 게 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rustige mappen. Niets te melden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas tranquilas. Nada a relatar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихо в папках. Отчитываться не о чем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörler sakin. Bildirecek bir şey yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹很安静。没什么可报告的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案夾很安靜。沒什麼可報告的。"
          }
        }
      }
    },
    "Quiet pass across every watch root — useful when you tighten a rule and want what’s already there to move.": {
      "comment": "Auto re-sort footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Durchgang über alle Überwachungsordner — praktisch, wenn du eine Regel verschärfst und das, was schon da ist, mitziehen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pasada tranquila por todas las carpetas vigiladas: útil cuando afinas una regla y quieres que lo que ya está ahí se mueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passage tranquille sur tous les dossiers surveillés — utile quand tu resserres une règle et que ce qui est déjà là doit suivre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passaggio silenzioso su tutte le radici osservate: utile quando stringi una regola e vuoi che ciò che c’è già si sposti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての監視ルートを静かにもう一度整理します。ルールを絞ったとき、すでにあるファイルも動かしたい場合に便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 감시 루트를 조용히 한 번 훑어요. 규칙을 조이고 이미 있는 파일도 옮기고 싶을 때 유용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stille ronde over alle bewaakte hoofdmappen — handig als je een regel aanscherpt en wilt dat wat er al staat ook meegaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma passada silenciosa em todas as raízes monitoradas — útil quando você ajusta uma regra e quer que o que já está lá também seja movido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихий проход по всем отслеживаемым корням — полезно, когда вы уточнили правило и хотите, чтобы уже лежащие файлы тоже переехали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm izlenen köklerde sessiz bir tarama — bir kuralı sıkılaştırdığında mevcut dosyaların da taşınmasını istiyorsan işe yarar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静默扫描所有监视根目录——收紧规则后，让已有文件按新规则重新整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靜默掃描所有監視根目錄——收緊規則後，讓已有檔案按新規則重新整理。"
          }
        }
      }
    },
