    "First enabled rule wins. Rules run before automatic sorted folders (Images, Documents, Review folder, etc.).": {
      "comment": "Sorted folders tab routing section footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste aktivierte Regel gewinnt. Regeln laufen vor den automatischen Sortierordnern (Bilder, Dokumente, Prüfordner usw.)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana la primera regla activada. Las reglas se aplican antes que las carpetas ordenadas automáticas (Imágenes, Documentos, carpeta de revisión, etc.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première règle activée l’emporte. Les règles passent avant les dossiers triés automatiques (Images, Documents, dossier à vérifier, etc.)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vince la prima regola attiva. Le regole vengono applicate prima delle cartelle ordinate automatiche (Immagini, Documenti, cartella Da rivedere, ecc.)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に有効なルールが優先されます。ルールは自動の整理先フォルダ(画像、書類、確認フォルダなど)より先に実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 먼저 켜진 규칙이 적용돼요. 규칙은 자동 정리 폴더(이미지, 문서, 검토 폴더 등)보다 먼저 실행돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste ingeschakelde regel wint. Regels gaan vóór de automatisch gesorteerde mappen (Afbeeldingen, Documenten, Controlemap, enz.)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale a primeira regra ativada. As regras rodam antes das pastas organizadas automáticas (Imagens, Documentos, pasta Revisão etc.)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Побеждает первое включённое правило. Правила срабатывают раньше автоматических папок (Изображения, Документы, папка «На проверку» и т. д.)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk açık kural kazanır. Kurallar otomatik sıralama klasörlerinden (Görseller, Belgeler, İnceleme klasörü vb.) önce çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一条启用的规则生效。规则在自动分类文件夹（图片、文档、待审文件夹等）之前执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一個啟用的規則獲勝。規則在自動排序的資料夾（映像、文件、審查資料夾等）之前執行。"
          }
        }
      }
    },
