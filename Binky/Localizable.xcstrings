            "state": "translated",
            "value": "Está en tu lista de ignorados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ta liste d’exclusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella tua lista da ignorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無視リストにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무시 목록에 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat op je negeerlijst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está na sua lista de ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вашем списке исключений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoksay listende."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的忽略列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的忽略名單上。"
          }
        }
      }
    },
    "One quiet summary of what Binky handled. Requires notification permission.": {
      "comment": "Digest footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhige Zusammenfassung dessen, was Binky erledigt hat. Erfordert die Mitteilungsberechtigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen tranquilo de lo que Binky ha gestionado. Requiere permiso de notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un résumé tranquille de ce que Binky a géré. Nécessite l’autorisation de notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo riepilogo tranquillo di ciò che Binky ha gestito. Richiede il permesso per le notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky が片付けた内容を、静かに 1 通にまとめます。通知の許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky가 처리한 내용을 조용히 한 번 요약해요. 알림 권한이 필요해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rustig overzicht van wat Binky heeft afgehandeld. Vereist toestemming voor meldingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um resumo tranquilo do que o Binky resolveu. Requer permissão de notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна тихая сводка о том, что сделал Binky. Нужно разрешение на уведомления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky’nin hallettiklerinin tek bir sakin özeti. Bildirim izni gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Binky 处理内容的简要摘要。需要通知权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對 Binky 所處理事情的一個安靜的總結。需要通知許可。"
          }
        }
      }
    },
    "Only files inside your watch folder can be sorted from here.": {
      "comment": "Organizer drop zone footnote.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von hier aus lassen sich nur Dateien in deinem Überwachungsordner sortieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde aquí solo se pueden ordenar archivos de tu carpeta vigilada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers de ton dossier surveillé peuvent être triés d’ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da qui si possono smistare solo i file nella tua cartella osservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから整理できるのは、監視フォルダ内のファイルだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 감시 폴더 안의 파일만 정리할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf hier kun je alleen bestanden in je bewaakte map sorteren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é possível organizar daqui arquivos que estejam na sua pasta monitorada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсюда можно сортировать только файлы из вашей отслеживаемой папки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradan yalnızca izlenen klasörünün içindeki dosyalar sıralanabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有监视文件夹内的文件才能从此处整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能從此處對監視資料夾內的檔案進行排序。"
          }
        }
      }
    },
    "Open .dmg installers and copy the app, then trash the image.": {
      "comment": "Routing rule template subtitle.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet .dmg-Installer, kopiert die App und legt dann das Image in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los instaladores .dmg, copia la app y manda la imagen a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les installeurs .dmg et copie l’app, puis met l’image à la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri gli installer .dmg e copia l’app, poi butta l’immagine nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".dmg インストーラを開いてアプリをコピーし、ディスクイメージをゴミ箱へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".dmg 설치 파일을 열어 앱을 복사한 다음 이미지를 휴지통으로 보내요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open .dmg-installatieprogramma’s en kopieer de app, zet daarna de schijfkopie in de prullenbak."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra instaladores .dmg e copie o app, depois envie a imagem para a Lixeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает установщики .dmg, копирует приложение и отправляет образ в Корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".dmg yükleyicilerini açar, uygulamayı kopyalar, sonra görüntüyü Çöp Sepeti’ne atar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 .dmg 安装器，拷贝 App，然后将磁盘映像移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 .dmg 安裝器，拷貝 App，然後將磁碟映像移到垃圾桶。"
          }
        }
      }
    },
