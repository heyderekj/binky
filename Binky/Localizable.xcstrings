    "Move, extract, install a disk image, fan out by tag, zip, trash, or rename in place.": {
      "comment": "VoiceOver: rule action picker.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben, entpacken, Disk-Image installieren, nach Tag auffächern, zippen, in den Papierkorb legen oder an Ort und Stelle umbenennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, extraer, instalar una imagen de disco, repartir por etiqueta, comprimir en zip, mover a la papelera o renombrar en el sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer, extraire, installer une image disque, répartir par tag, zipper, mettre à la corbeille ou renommer sur place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta, estrai, installa un’immagine disco, distribuisci per tag, comprimi in zip, butta nel Cestino o rinomina sul posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動、展開、ディスクイメージのインストール、タグで振り分け、zip、ゴミ箱、その場で名前変更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동, 풀기, 디스크 이미지 설치, 태그별 나누기, 압축, 휴지통, 제자리에서 이름 바꾸기."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats, pak uit, installeer een schijfkopie, verdeel op tag, zip, gooi weg of hernoem ter plekke."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover, extrair, instalar uma imagem de disco, distribuir por tag, compactar em zip, enviar para a Lixeira ou renomear no lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить, распаковать, установить образ диска, разложить по меткам, заархивировать, удалить в Корзину или переименовать на месте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşı, aç, disk görüntüsü yükle, etikete göre dağıt, zip’le, Çöp Sepeti’ne at ya da yerinde yeniden adlandır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动、解压、安装磁盘映像、按标签分类、压缩、废纸篓或原地重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動、提取、安裝磁碟映像、按標籤扇出、壓縮、回收站或就地重新命名。"
          }
        }
      }
    },
