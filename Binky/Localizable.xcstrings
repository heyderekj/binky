    "Copy a supported file in Finder, or copy an image (PNG or TIFF), then try again.": {
      "comment": "Alert message for empty clipboard paste.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie eine unterstützte Datei im Finder oder kopieren Sie ein Bild (PNG oder TIFF) und versuchen Sie es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie un archivo compatible en Finder o copie una imagen (PNG o TIFF) y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez un fichier pris en charge dans le Finder ou copiez une image (PNG ou TIFF), puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un file supportato nel Finder o copia un'immagine (PNG o TIFF), quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder でサポートされているファイルをコピーするか、画像 (PNG または TIFF) をコピーして、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 지원되는 파일을 복사하거나 이미지(PNG 또는 TIFF)를 복사한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer een ondersteund bestand in Finder of kopieer een afbeelding (PNG of TIFF) en probeer het vervolgens opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie um arquivo compatível no Finder ou copie uma imagem (PNG ou TIFF) e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте поддерживаемый файл в Finder или скопируйте изображение (PNG или TIFF), а затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir dosyayı Finder'da kopyalayın veya bir görüntüyü (PNG veya TIFF) kopyalayın ve tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中复制支持的文件，或复制图像（PNG 或 TIFF），然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中複製支援的檔案，或複製影像（PNG 或 TIFF），然後重試。"
          }
        }
      }
    },
