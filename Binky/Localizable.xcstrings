    "Previous session ended unexpectedly; no Apple diagnostic payload is attached yet.\n\n": {
      "comment": "Crash body note when MetricKit summary is unavailable.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige Sitzung endete unerwartet; es ist noch keine Apple-Diagnose angehängt.\n\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión anterior terminó de forma inesperada; todavía no hay datos de diagnóstico de Apple adjuntos.\n\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session précédente s’est terminée de façon inattendue ; aucune donnée de diagnostic Apple n’est encore jointe.\n\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione precedente è terminata in modo imprevisto; non è ancora allegato nessun payload diagnostico di Apple.\n\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッションが予期せず終了しました。Apple の診断ペイロードはまだ添付されていません。\n\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 세션이 예기치 않게 종료됐어요. Apple 진단 페이로드는 아직 첨부되지 않았어요.\n\n"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige sessie eindigde onverwacht; er is nog geen diagnostische payload van Apple bijgevoegd.\n\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão anterior terminou inesperadamente; ainda não há payload de diagnóstico da Apple anexado.\n\n"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлый сеанс завершился неожиданно; диагностических данных Apple пока нет.\n\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki oturum beklenmedik şekilde sona erdi; henüz Apple tanılama verisi eklenmedi.\n\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次排序意外结束；尚未附加 Apple 诊断数据。\n\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次排序意外結束；尚未附加 Apple 診斷資料。\n\n"
          }
        }
      }
    },
