    "Finder tags didn’t stick for %lld files — the sort still landed.": {
      "comment": "Sort ancillary warning; multiple tag failures. Argument is integer count.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-Tags blieben bei %lld Dateien nicht hängen — sortiert wurde trotzdem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas del Finder no se aplicaron a %lld archivos; la ordenación se hizo igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tags Finder n’ont pas été appliqués à %lld fichiers — le tri a quand même eu lieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tag Finder non sono rimasti su %lld file — lo smistamento è comunque andato a buon fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のファイルで Finder タグを付けられませんでした。整理自体は完了しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %lld개에 Finder 태그가 붙지 않았어요. 정리 자체는 끝났어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-tags bleven niet hangen bij %lld bestanden — de sortering is wel gelukt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tags do Finder não pegaram em %lld arquivos — a organização foi concluída mesmo assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки Finder не прижились у файлов: %lld — сортировка при этом прошла."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dosyada Finder etiketleri tutmadı — sıralama yine de tamamlandı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达标签不适合 %lld 文件——排序仍然有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 標籤不適合 %lld 檔案－排序仍然有效。"
          }
        }
      }
    },
